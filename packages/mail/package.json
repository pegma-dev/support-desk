{
  "name": "@pegma/support-desk-mail",
  "version": "0.0.0",
  "description": "Provider-neutral outbound mail delivery contracts and worker for Support Desk.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/support-desk.git",
    "directory": "packages/mail"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@pegma/spine": "0.1.1",
    "@pegma/storage-core": "0.3.0",
    "@pegma/support-desk-application": "0.0.0",
    "@pegma/support-desk-templates": "0.0.0"
  }
}
