{
  "name": "support-desk",
  "version": "0.0.0",
  "private": true,
  "description": "A composable, open-source support queue for web and email.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "example": "npm run build && node --experimental-strip-types examples/composition/run.ts"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@pegma/mail": "0.1.1",
    "@pegma/scheduler": "^0.1.0",
    "@pegma/storage-azure-tables": "0.4.0",
    "@types/node": "^26.1.2",
    "azurite": "^3.36.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@11.18.0"
}
