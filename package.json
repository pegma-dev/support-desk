{
  "name": "support-desk",
  "version": "0.0.0",
  "private": true,
  "description": "A composable, open-source support queue for web and email.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && vitest run",
    "knowledge-ai:baseline": "node scripts/knowledge-ai-baseline.mjs",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-verification.mjs publish",
    "example": "pnpm run build && node --experimental-strip-types examples/composition/run.ts",
    "ai:example": "pnpm run build && tsc -p tsconfig.ai-example.json --pretty false && node .example-dist/ai/run.js",
    "release:verify": "node scripts/release-verification.mjs verify",
    "release:preflight": "node scripts/release-verification.mjs preflight"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@pegma/audit": "0.2.0",
    "@pegma/authorization-core": "0.4.0",
    "@pegma/knowledge-base-application": "0.1.8",
    "@pegma/knowledge-base-contracts": "0.1.8",
    "@pegma/mail": "0.1.1",
    "@pegma/scheduler": "^0.1.0",
    "@pegma/spine": "0.1.2",
    "@pegma/storage-azure-tables": "0.4.0",
    "@pegma/storage-core": "0.4.0",
    "@pegma/support-desk-ai": "0.2.12",
    "@pegma/support-desk-application": "0.2.12",
    "@pegma/support-desk-templates": "0.2.12",
    "@types/node": "^26.6.6",
    "azurite": "^3.37.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5"
}
